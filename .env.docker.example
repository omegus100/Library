# Settings for docker-compose.yml.
# Portainer: paste these into the stack's "Environment variables" (Advanced mode).
# Plain Docker: copy to .env next to docker-compose.yml. Never commit .env.

# Required. Long random string that signs sign-ins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   (or any password generator, 40+ characters)
SESSION_SECRET=

# Port on the NAS: the app opens at http://<nas-ip>:8080
APP_PORT=8080

# Image version: latest, or a release like 2.0.0
IMAGE_TAG=latest

# MongoDB image. If the library-mongo container keeps restarting, your NAS CPU lacks AVX:
# change this to mongo:4.4
MONGO_IMAGE=mongo:7

# Where data lives. Leave as-is for Docker named volumes, or point at NAS folders
# (create the folders first), e.g. /volume1/docker/library/db
MONGO_DATA=mongo-data
COVERS_DATA=covers
BACKUP_DATA=backups

# Optional: Google Books API key (avoids the shared "too many requests" limit)
GOOGLE_BOOKS_API_KEY=
