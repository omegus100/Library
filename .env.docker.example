# Settings for docker-compose.yml.
# Portainer: paste these into the stack's "Environment variables" (Advanced mode).
# Plain Docker: copy to .env next to docker-compose.yml. Never commit .env.

# Required. Long random string that signs sign-ins (any password generator, 40+ characters).
SESSION_SECRET=

# Where the database and covers live. A Docker volume name (default), or a NAS folder:
#   DATA_PATH=/volume1/docker/library
DATA_PATH=library-data

# Owner of the files in DATA_PATH. Synology: run `id` over SSH, or use your admin user (often 1026 / 100).
PUID=1000
PGID=1000

# Port on the NAS: the app opens at http://<nas-ip>:8080
APP_PORT=8080

# Image version: latest, or a release like 2.0.0
IMAGE_TAG=latest

TZ=UTC

# Optional: Google Books API key (avoids the shared "too many requests" limit)
GOOGLE_BOOKS_API_KEY=

# Optional: your Calibre library folder (contains metadata.db). Mounted read-only; turn it on in Settings → Calibre ebooks.
#   CALIBRE_LIBRARY_PATH=/volume1/Media/Books
CALIBRE_LIBRARY_PATH=
