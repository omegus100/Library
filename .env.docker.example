# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Long random string that signs sign-in tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Port on the NAS the app is reachable at (http://<nas-ip>:8080)
APP_PORT=8080

# The address you open the app at (only matters if you call the API from another site)
CLIENT_ORIGIN=http://localhost:8080

# Optional: Google Books API key (avoids the shared "too many requests" limit)
GOOGLE_BOOKS_API_KEY=
