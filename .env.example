# Copy the server section to server/.env and fill in real values. Never commit .env files.
# Full list and explanations: ENV_SETUP.md. Docker uses .env.docker.example instead.

# ---- server/.env ----
MONGO_URI=mongodb://localhost:27017/library
# Optional: pick the database by name (e.g. a dev copy) instead of the one in MONGO_URI
MONGO_DB_NAME=
PORT=5000
# Site address(es) allowed to call the API. Comma-separated. No trailing slash.
CLIENT_ORIGIN=http://localhost:3000
# Required in production: long random string that signs sign-in tokens
SESSION_SECRET=
# db (covers inside each book) or local (files in COVER_DIR)
COVER_STORAGE=db
COVER_DIR=./data/covers
# Optional: avoids Google Books' shared rate limit
GOOGLE_BOOKS_API_KEY=

# ---- client/.env.* (committed; public values only) ----
# Empty = relative /api paths (dev proxy, or one server for site + API).
# VITE_API_BASE_URL=
